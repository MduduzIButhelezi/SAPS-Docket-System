{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=saps-docket.db"
  },

  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY",
    "Issuer": "SAPS.DocketSystem.Api",
    "Audience": "SAPS.DocketSystem.Ui",
    "ExpiryHours": 8
  },

  "Translation": {
    "Provider": "Lelapa",
    "BaseUrl": "https://api.lelapa.ai/v1/translate/process",
    "ApiKey": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}